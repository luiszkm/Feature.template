# Copy to compose.env and adjust before `docker compose up`.
# compose.env is gitignored (see .gitignore); never commit real secrets.

POSTGRES_PASSWORD=change-me-postgres

# API runs as Production by default (see docker-compose.yml).
# Use Development only for local debugging of the containerized API.
ASPNETCORE_ENVIRONMENT=Production

# Required when Jwt:Enabled=true (Production has no baked-in secret).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=Product.Template
JWT_AUDIENCE=Product.Template.Api

# First allowed CORS origin (add more via compose overrides if needed).
CORS_ORIGIN=http://localhost:5080

# Required outside Development for DevBootstrapSeeder admin user.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_EMAIL=admin@producttemplate.com

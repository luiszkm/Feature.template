{
  "MultiTenancy": {
    "HeaderName": "X-Tenant",
    "BaseDomain": "api.example.com",
    "AllowDevFallback": true,
    "DevTenantKey": "dev"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ProductTemplateV2;Username=postgres;Password=dev-postgres-change-me"
  },
  "Database": {
    "UseInMemory": false
  },
  "Seed": {
    "AdminEmail": "admin@producttemplate.com"
  },
  "Jwt": {
    "Enabled": true,
    "Secret": "dev-only-secret-key-minimum-32-characters-long",
    "Issuer": "Product.Template",
    "Audience": "Product.Template.Api",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:5080" ]
  }
}

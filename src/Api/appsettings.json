{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "UseInMemory": false
  },
  "Seed": {
    "AdminEmail": "admin@producttemplate.com",
    "AdminFirstName": "System",
    "AdminLastName": "Administrator"
  },
  "Jwt": {
    "Enabled": true,
    "Secret": "",
    "Issuer": "Product.Template",
    "Audience": "Product.Template.Api",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "ServiceName": "Product.Template.v2",
    "EnableTraces": false,
    "EnableMetrics": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "MultiTenancy": {
    "HeaderName": "X-Tenant",
    "BaseDomain": null,
    "AllowDevFallback": false,
    "DevTenantKey": "dev"
  },
  "FeatureFlags": {
    "EnableAI": false
  },
  "Ai": {
    "Llm": {
      "Provider": "OpenRouter",
      "ApiKey": "",
      "Model": "openai/gpt-4o-mini",
      "BaseUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

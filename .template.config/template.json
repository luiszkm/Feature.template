{
  "$schema": "http://json.schemastore.org/template",
  "author": "Luis Soares",
  "classifications": [
    "Web API",
    "ERP",
    "VSA"
  ],
  "identity": "LuisSoares.ProductTemplate.Vsa",
  "name": "Product Template \u2014 ERP VSA (.NET 10)",
  "shortName": "product-template",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "preferNameDirectory": true,
  "symbols": {
    "ProductName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Product.Template",
      "replaces": "Product.Template",
      "description": "Nome do produto: JWT Issuer/Audience, t\u00edtulo OpenAPI, ServiceName (observability), Directory.Build.props <Product>."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            ".git/**",
            ".idea/**",
            "**/TestResults/**",
            ".template.config/**",
            "**/node_modules/**",
            "**/dist/**",
            ".tools/**",
            "**/playwright-report/**",
            "**/test-results/**",
            ".specs/**"
          ]
        }
      ]
    }
  ],
  "guids": [
    "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
    "B2C3D4E5-F6A7-8901-BCDE-F12345678901",
    "C3D4E5F6-A7B8-9012-CDEF-123456789012",
    "3795C7EC-EC36-4FD9-A652-14AA8BA40952"
  ]
}
